{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MsmConnect",
  "version": "1.5.5",
  "identifier": "com.msm.msmconnect",
  "build": {
    "frontendDist": "../ui_dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MsmConnect • Biometric Security & AuraDrop",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "opener": {}
  }
}

